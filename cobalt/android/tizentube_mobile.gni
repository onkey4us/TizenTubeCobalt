declare_args() {
  # When true, the APK is built for Android phones: it loads
  # https://m.youtube.com with a Chrome-for-Android mobile user agent, locks
  # the activity to landscape, runs immersive fullscreen and injects the
  # bundled TizenTube mobile userscript (assets/tizentube_mobile/).
  #
  # Set `tizentube_mobile_ui = false` in args.gn to restore the original
  # youtube.com/tv (leanback) behaviour for Android TV builds.
  # See docs/TOUCH_MOBILE.md.
  tizentube_mobile_ui = true
}
